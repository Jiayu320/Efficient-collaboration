def utf8_to_ascii(input_string):
    if not isinstance(input_string, str):
        return None
    
    try:
        ascii_codes = []
        for char in input_string:
            ascii_code = ord(char)
            ascii_codes.append(ascii_code)
        return ascii_codes
    except UnicodeEncodeError:
        return None
