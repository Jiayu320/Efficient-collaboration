import math

class RouteSimulator:
    def __init__(self, x=0, y=0):
        self.x = x
        self.y = y
        self.move_history = []

    def move(self, distance, angle_degrees):
        # Convert angle from degrees to radians
        angle_radians = math.radians(angle_degrees)
        
        # Calculate new position using trigonometric functions
        new_x = self.x + distance * math.cos(angle_radians)
        new_y = self.y + distance * math.sin(angle_radians)
        
        # Update current position
        self.x = new_x
        self.y = new_y
        
        # Add move record to history
        self.move_history.append({
            'distance': distance,
            'angle_degrees': angle_degrees,
            'position': (round(new_x, 2), round(new_y, 2))
        })
```

