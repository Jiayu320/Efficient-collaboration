class Order:
    def __init__(self, order_id):
        self.order_id = order_id
        self.items = []
        self.total_price = 0.0
        self.status = "未支付"

    def add_item(self, item_name, item_price):
        if not isinstance(item_price, (int, float)) or item_price <= 0:
            return "商品价格必须是正数"

        item = {"name": item_name, "price": item_price}
        self.items.append(item)

    def remove_item(self, item_name):
        for item in self.items:
            if item["name"] == item_name:
                self.items.remove(item)
                break
        else:
            return "该商品不存在于订单中"

    def calculate_total_price(self):
        self.total_price = sum(item["price"] for item in self.items)

    def pay_order(self):
        if not self.items:
            return "订单中没有商品"
        self.status = "已支付"

    def cancel_order(self):
        self.status = "已取消"

    def view_order(self):
        print("订单编号：", self.order_id)
        print("商品列表：")
        for item in self.items:
            print("- {}: ￥{}".format(item["name"], item["price"]))
        print("总价格：￥{}".format(self.total_price))
        print("状态：", self.status)
```
