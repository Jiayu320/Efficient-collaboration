    },
    "clarityAndMachineUsability": {
      "score": "[Enter a score from 1-5]",
      "justification": "[Your justification here. Is the response format clean and easy to parse?]"
    },
    "relevanceAndConciseness": {
      "score": "[Enter a score from 1-5]",
      "justification": "[Your justification here. Was the response free of irrelevant fluff?]"
    },
    "overallSummary": "[Provide a final, concise paragraph summarizing the Executor's performance on this specific task and its reliability as a component in the system.]"
  }
}
