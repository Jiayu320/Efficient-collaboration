label("$C$", C, SE);
label("$D$", D, S);
label("$O$", O, NW);
label("$\mathbf{a}$", A/2, W);
label("$\mathbf{b}$", B/2, N);
label("$\mathbf{c}$", C/2, NE);
label("$\mathbf{d}$", D/2, W);
