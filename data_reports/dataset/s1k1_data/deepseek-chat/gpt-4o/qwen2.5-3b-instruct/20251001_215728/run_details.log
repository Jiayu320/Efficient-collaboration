\langle x_1, x_2 \rangle = d^2 \cos(\theta) < d^2
\]
This implies:
\[
\langle v_{x_1}, v_{x_2} \rangle = \frac{2}{d^2} \langle x_1, x_2 \rangle < \frac{2}{d^2} d^2 = 2 < 1
