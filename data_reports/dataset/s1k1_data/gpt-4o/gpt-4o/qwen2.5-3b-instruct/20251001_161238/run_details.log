\[
\langle x_i - y, x_j - y \rangle = \langle x_i, x_j \rangle - \langle x_i, x_j \rangle - \langle x_i, x_j \rangle + \|y\|^2 = 0 - \frac{d^2}{2} - \frac{d^2}{2} + \|y\|^2 = 0
\]
