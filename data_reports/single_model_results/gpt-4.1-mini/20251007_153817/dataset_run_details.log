\]

\[
0 = 9 s^4 - 150 s^3 - 12 s^3 + 865 s^2 + 72 s^2 - 2000 s - 108 s + 1600,
\]
\[
0 = 9 s^4 - 162 s^3 + 937 s^2 - 2108 s + 1600.
\]

