[INFO] 10-06 23:30:21 single_model_only.py:731] ```python
import re

def remove_html_tags(s):
    if not isinstance(s, str):
        raise ValueError("Input must be a string")

    if not s:
        return ""

    # Regular expression patterns
    tag_pattern = r"<[^>]+>"
    comment_pattern = r"<!--.*?-->"
    doctype_pattern = r"<!DOCTYPE.*?>"

    # Remove comments
    s = re.sub(comment_pattern, '', s)
    # Remove doctype declarations
    s = re.sub(doctype_pattern, '', s, flags=re.IGNORECASE)
    # Remove HTML tags
    s = re.sub(tag_pattern, '', s)

    return s.strip()
```
