import xml.etree.ElementTree as ET

def parse_xml(file_path, tag_name):
    try:
        tree = ET.parse(file_path)
        root = tree.getroot()
        
        # Initialize an empty list to store the extracted text content
        data_list = []
        
        # Find all child elements with the specified tag name under the root node
        for element in root.findall(tag_name):
            if element.text is not None:
                data_list.append(element.text)
        
        return data_list

    except ET.ParseError:
        # If parsing fails, return an empty list
        return []
