def utf8_to_ascii(input_string):
    if not isinstance(input_string, str):
        return None
    
    try:
        ascii_codes = [ord(char) for char in input_string]
    except TypeError:
        return None
    
    # Check if there's any non-ASCII character
    for code in ascii_codes:
        if code > 127:
            return ascii_codes  # Non-ASCII character handling as per the test case
    
    return ascii_codes
```
