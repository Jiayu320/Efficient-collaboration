from datetime import datetime

class Schedule:
    def __init__(self):
        # Initialize an empty dictionary to store events
        self.events = {}

    def add_event(self, event_name, event_date):
        # Add an event under the specified date
        if event_date in self.events:
            self.events[event_date].append(event_name)
        else:
            self.events[event_date] = [event_name]

    def view_events(self):
        # View all events formatted as "YYYY-MM-DD HH:MM"
        for date, event_list in sorted(self.events.items()):
            formatted_date = date.strftime("%Y-%m-%d %H:%M")
            print(f"{formatted_date}:")
            for event_name in event_list:
                print(f"- {event_name}")
            print()  # New line after each date

    def remove_event(self, event_name, event_date):
        # Remove the specified event from the specified date
        if event_date in self.events and event_name in self.events[event_date]:
            self.events[event_date].remove(event_name)
            if not self.events[event_date]:  # Check if the event list is empty
                del self.events[event_date]  # Delete the entry for that date
        else:
            print(f"Event '{event_name}' not found")
```

